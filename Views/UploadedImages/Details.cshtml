@model ASPCoreWebMVC.Models.UploadedImage

@{
    ViewData["Title"] = "Image Details";
}

<h1>Image Details</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">File</dt>
        <dd class="col-sm-10"><img src="@Model.FilePath" alt="" style="max-width:400px;" /></dd>

        <dt class="col-sm-2">FileName</dt>
        <dd class="col-sm-10">@Model.FileName</dd>

        <dt class="col-sm-2">Content Type</dt>
        <dd class="col-sm-10">@Model.ContentType</dd>

        <dt class="col-sm-2">Size</dt>
        <dd class="col-sm-10">@Model.Size bytes</dd>

        <dt class="col-sm-2">Uploaded At</dt>
        <dd class="col-sm-10">@Model.UploadedAt.ToLocalTime().ToString()</dd>
    </dl>
</div>

<p>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
</p>
