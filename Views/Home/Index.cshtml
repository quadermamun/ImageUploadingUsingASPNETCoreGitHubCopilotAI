@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
    <p><a asp-controller="Home" asp-action="Upload">Upload an image</a></p>
</div>

@model ASPCoreWebMVC.Utilities.PaginatedList<ASPCoreWebMVC.Models.UploadedImage>

<div>
    <h2>Uploaded Images</h2>
    @if (!Model.Any())
    {
        <p>No uploaded images yet.</p>
    }
    else
    {
        <div style="display:flex; gap:1rem; flex-wrap:wrap;">
            @foreach (var item in Model)
            {
                <div style="width:150px; text-align:center;">
                    <a href="@item.FilePath" target="_blank"><img src="@item.FilePath" alt="img" style="max-width:150px; max-height:150px; display:block;" /></a>
                </div>
            }
        </div>

        <nav aria-label="Page navigation" style="margin-top:1rem;">
            <ul class="pagination">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" href="@Url.Action("Index", "Home", new { page = Model.PageIndex - 1 })">Previous</a>
                </li>
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", "Home", new { page = p })">@p</a>
                    </li>
                }
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" href="@Url.Action("Index", "Home", new { page = Model.PageIndex + 1 })">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>
